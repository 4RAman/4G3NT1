{
  "ollama_host": "http://192.168.1.10:11434",
  "local_ollama_host": "http://127.0.0.1:11434",
  "local_model": "smollm2:135m",
  "remote_model": "llama3.2:1b",
  "prefer_remote": true,
  "fallback_to_local": true,
  "remote_timeout_s": 5,
  "local_timeout_s": 60,
  "ble_device_name": "AIButton",
  "sounds_enabled": true,
  "database_path": "data/events.db",
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8080,
  "modes": [
    {
      "name": "5AM Alarm",
      "template": "alarm",
      "activation": {
        "type": "schedule",
        "at": "05:00",
        "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
      },
      "message": "Wake up",
      "label": "",
      "snooze_minutes": 9,
      "dismiss_event": "woke_up"
    },
    {
      "name": "Gratitude",
      "template": "counter",
      "activation": { "type": "manual" },
      "event": "gratitude",
      "tap_increment": 1,
      "long_increment": 10,
      "double_increment": 20
    },
    {
      "name": "Stopwatch",
      "template": "stopwatch",
      "activation": { "type": "manual" },
      "log_as": "stopwatch"
    },
    {
      "name": "Pomodoro",
      "template": "pomodoro",
      "activation": { "type": "manual" },
      "work_minutes": 25,
      "break_minutes": 5,
      "extend_minutes": 10,
      "log_as": "pomodoro",
      "short_press": "start_pause",
      "long_press": "restart",
      "double_tap": "extend"
    },
    {
      "name": "Default",
      "template": "actions",
      "activation": { "type": "always" },
      "short_press": { "action": "enter_mode", "target": "Pomodoro" },
      "long_press": { "action": "enter_mode", "target": "Stopwatch" },
      "double_tap": { "action": "enter_mode", "target": "Gratitude" }
    }
  ]
}
