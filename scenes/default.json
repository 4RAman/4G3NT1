{
  "name": "Default",
  "ble_device_name": "AIButton",
  "sounds_enabled": false,
  "database_path": "data/events.db",
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8080,
  "min_flash_period_s": 0.3,
  "modes": [
    {
      "name": "Stopwatch",
      "template": "stopwatch",
      "activation": {
        "type": "manual"
      },
      "log_as": "stopwatch",
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 2,
            "color": "#421e00"
          },
          {
            "every_s": 1,
            "color": "#92904f"
          }
        ]
      }
    },
    {
      "name": "Pomodoro",
      "template": "pomodoro",
      "activation": {
        "type": "manual"
      },
      "looks": {
        "WORKING": "Ponder",
        "RESTING": "Cooldown"
      },
      "work_s": 1500,
      "break_s": 6006,
      "long_break_s": 900,
      "blocks_before_long_break": 4,
      "extend_s": 600,
      "rounds": 0,
      "lead_in_s": 3,
      "advance": "break_only",
      "log_as": "pomodoro",
      "waiting_style": "solid",
      "short_press": "toggle",
      "long_press": "exit",
      "double_tap": "extend"
    },
    {
      "name": "Metronome",
      "template": "metronome",
      "activation": {
        "type": "manual"
      },
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 8,
            "color": "#00ff2a"
          },
          {
            "every_s": 4,
            "color": "#103d00"
          },
          {
            "every_s": 2,
            "color": "#4c8e9a"
          },
          {
            "every_s": 1,
            "color": "#1d2062"
          }
        ]
      },
      "start_bpm": 120,
      "tap_history": 4,
      "reset_gap_s": 2,
      "max_bpm": 600,
      "sound_on_tap": true,
      "log_as": "metronome"
    },
    {
      "name": "Counter",
      "template": "counter",
      "activation": {
        "type": "manual"
      },
      "event": "Habit"
    },
    {
      "name": "Alarm",
      "template": "alarm",
      "activation": {
        "type": "schedule",
        "at": "07:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "message": "Wake up",
      "label": "",
      "snooze_minutes": 10,
      "dismiss_event": "woke_up"
    },
    {
      "name": "Countdown 60s",
      "template": "countdown",
      "activation": {
        "type": "manual"
      },
      "minutes": 1,
      "label": "1min",
      "style": "flash",
      "period_s": 0.5,
      "ramp": [
        {
          "color": "#240000",
          "at": 0
        },
        {
          "color": "#703c00",
          "at": 0.2
        },
        {
          "color": "#999900",
          "at": 0.4
        },
        {
          "color": "#00c79f",
          "at": 0.6
        },
        {
          "color": "#000cb8",
          "at": 0.8
        },
        {
          "color": "#ffffff",
          "at": 1
        }
      ],
      "ring_on_finish": true,
      "log_as": "countdown",
      "ladder": {
        "enabled": true,
        "tick_s": 1,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 5,
            "color": "#00ffd5"
          },
          {
            "every_s": 2,
            "color": "#6689db"
          }
        ]
      }
    },
    {
      "name": "Test Reminder",
      "template": "reminders",
      "activation": {
        "type": "schedule",
        "at": "12:45",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "looks": {
        "ALERT": "Cops"
      },
      "message": "Testing testing 123",
      "label": "test",
      "chime": true,
      "cleared_event": "done test",
      "timeout_minutes": 1
    },
    {
      "name": "Reaction",
      "template": "reaction",
      "activation": {
        "type": "manual"
      },
      "min_delay_s": 2,
      "max_delay_s": 6,
      "rounds": 5,
      "slowest_ms": 600,
      "reveal_s": 1.2,
      "log_as": "reaction",
      "ramp": [
        {
          "color": "#ff0000",
          "at": 0
        },
        {
          "color": "#ff8800",
          "at": 0.3333333333333333
        },
        {
          "color": "#ffff00",
          "at": 0.6666666666666666
        },
        {
          "color": "#00ff00",
          "at": 1
        }
      ]
    },
    {
      "name": "Work Alarm",
      "template": "alarm",
      "activation": {
        "type": "schedule",
        "at": "07:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri"
        ]
      },
      "looks": {
        "ALERT": "Cops"
      },
      "message": "Go to work!",
      "label": "",
      "snooze_minutes": 5,
      "dismiss_event": ""
    },
    {
      "name": "Launcher",
      "template": "launcher",
      "activation": {
        "type": "manual"
      },
      "targets": "Stopwatch\nPomodoro\nMetronome\nCounter\nAlarm\nCountdown 60s\nReaction",
      "return_after": true,
      "log_as": ""
    },
    {
      "name": "Midi Actions",
      "template": "actions",
      "activation": {
        "type": "always"
      },
      "short_press": {
        "action": "midi",
        "port": "4G3NT",
        "channel": 1,
        "kind": "note_on",
        "number": 94,
        "value": 127
      },
      "long_press": {
        "action": "enter_mode",
        "target": "Stopwatch"
      },
      "double_tap": {
        "action": "midi",
        "port": "4G3NT",
        "channel": 1,
        "kind": "note_on",
        "number": 94,
        "value": 127
      },
      "triple_tap": {
        "action": "midi",
        "port": "4G3NT",
        "channel": 1,
        "kind": "note_on",
        "number": 89,
        "value": 127
      },
      "tap_5": {
        "action": "midi",
        "port": "4G3NT",
        "channel": 1,
        "kind": "note_on",
        "number": 86,
        "value": 127
      }
    },
    {
      "name": "Actions",
      "template": "actions",
      "activation": {
        "type": "always"
      },
      "short_press": {
        "action": "log",
        "event": "button_press"
      }
    }
  ],
  "led_palette": {
    "IDLE": {
      "style": "rainbow",
      "color": "#616161",
      "color2": "#001e1f",
      "period_s": 3.5
    },
    "LISTENING": {
      "style": "breathe",
      "color": "#515138",
      "color2": "#000000",
      "period_s": 3
    },
    "THINKING": {
      "style": "alternate",
      "color": "#ccfff7",
      "color2": "#6e6e6e",
      "period_s": 0.4
    },
    "SUCCESS": {
      "style": "solid",
      "color": "#00ff00",
      "color2": "#000000",
      "period_s": 1
    },
    "ERROR": {
      "style": "flash",
      "color": "#ff0000",
      "color2": "#000000",
      "period_s": 0.483333333333333
    },
    "ALERT": {
      "style": "alternate",
      "color": "#ff0000",
      "color2": "#fff700",
      "period_s": 0.4
    },
    "TIMING": {
      "style": "flash",
      "color": "#0062ff",
      "color2": "#000000",
      "period_s": 0.603333333333333
    },
    "COUNTING": {
      "style": "fade",
      "color": "#00eeff",
      "color2": "#0033ff",
      "period_s": 8
    },
    "WORKING": {
      "style": "breathe",
      "color": "#4400ff",
      "color2": "#000000",
      "period_s": 10
    },
    "RESTING": {
      "style": "breathe",
      "color": "#00ff88",
      "color2": "#000000",
      "period_s": 10
    },
    "METRONOME": {
      "style": "flash",
      "color": "#ffffff",
      "color2": "#000000",
      "period_s": 0.5
    }
  },
  "looks": {
    "Ponder": {
      "style": "fade",
      "color": "#9b86d5",
      "color2": "#8be5d6",
      "period_s": 4.05
    },
    "Cops": {
      "style": "alternate",
      "color": "#ff0000",
      "color2": "#0033ff",
      "period_s": 0.91
    },
    "Cooldown": {
      "style": "breathe",
      "color": "#00a8ff",
      "color2": "#000000",
      "period_s": 10
    }
  }
}
