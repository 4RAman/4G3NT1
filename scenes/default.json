{
  "name": "Default",
  "ble_device_name": "AIButton",
  "sounds_enabled": false,
  "database_path": "data/events.db",
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8080,
  "min_flash_period_s": 0.3,
  "modes": [
    {
      "name": "Main Menu",
      "template": "actions",
      "activation": {
        "type": "always"
      },
      "short_press": {
        "action": "enter_mode",
        "target": "Metronome"
      },
      "long_press": {
        "action": "enter_mode",
        "target": "Counter"
      },
      "double_tap": {
        "action": "enter_mode",
        "target": "Stopwatch"
      },
      "triple_tap": {
        "action": "enter_mode",
        "target": "Pomodoro"
      }
    },
    {
      "name": "Stopwatch",
      "template": "stopwatch",
      "activation": {
        "type": "manual"
      },
      "log_as": "stopwatch",
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 2,
            "color": "#002942"
          },
          {
            "every_s": 1,
            "color": "#4f6392"
          }
        ]
      }
    },
    {
      "name": "Pomodoro",
      "template": "pomodoro",
      "activation": {
        "type": "manual"
      },
      "looks": {
        "WORKING": "Ponder",
        "RESTING": "Cops"
      },
      "work_minutes": 0.1,
      "break_minutes": 0.1,
      "long_break_minutes": 15,
      "blocks_before_long_break": 4,
      "extend_minutes": 10,
      "advance": "break_only",
      "log_as": "pomodoro",
      "waiting_style": "solid",
      "short_press": "toggle",
      "long_press": "exit",
      "double_tap": "extend"
    },
    {
      "name": "Metronome",
      "template": "metronome",
      "activation": {
        "type": "manual"
      },
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 8,
            "color": "#00ff2a"
          },
          {
            "every_s": 4,
            "color": "#103d00"
          },
          {
            "every_s": 2,
            "color": "#4c8e9a"
          },
          {
            "every_s": 1,
            "color": "#1d2062"
          }
        ]
      },
      "start_bpm": 120,
      "tap_history": 4,
      "reset_gap_s": 2,
      "max_bpm": 600,
      "sound_on_tap": true,
      "log_as": "metronome"
    },
    {
      "name": "Counter",
      "template": "counter",
      "activation": {
        "type": "manual"
      },
      "event": "Habit"
    },
    {
      "name": "Alarm",
      "template": "alarm",
      "activation": {
        "type": "schedule",
        "at": "07:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "message": "Wake up",
      "label": "",
      "snooze_minutes": 10,
      "dismiss_event": "woke_up"
    },
    {
      "name": "Countdown 60s",
      "template": "countdown",
      "activation": {
        "type": "manual"
      },
      "minutes": 1,
      "label": "",
      "style": "flash",
      "period_s": 0.5,
      "ramp": [
        {
          "color": "#ff0000",
          "at": 0
        },
        {
          "color": "#ff8800",
          "at": 0.2
        },
        {
          "color": "#ffff00",
          "at": 0.4
        },
        {
          "color": "#00ffcc",
          "at": 0.6
        },
        {
          "color": "#0011ff",
          "at": 0.8
        },
        {
          "color": "#ffffff",
          "at": 1
        }
      ],
      "ring_on_finish": true,
      "log_as": "countdown",
      "ladder": {
        "enabled": false,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 5,
            "color": "#ffff00"
          },
          {
            "every_s": 2,
            "color": "#66ccff"
          },
          {
            "every_s": 1,
            "color": "#0033aa"
          }
        ]
      }
    },
    {
      "name": "Test Reminder",
      "template": "reminders",
      "activation": {
        "type": "schedule",
        "at": "12:45",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "looks": {
        "ALERT": "Cops"
      },
      "message": "Testing testing 123",
      "label": "test",
      "chime": true,
      "cleared_event": "done test",
      "timeout_minutes": 1
    }
  ],
  "led_palette": {
    "IDLE": {
      "style": "rainbow",
      "color": "#1a1a1a",
      "color2": "#00fbff",
      "period_s": 7.66
    },
    "LISTENING": {
      "style": "breathe",
      "color": "#515138",
      "color2": "#000000",
      "period_s": 3
    },
    "THINKING": {
      "style": "alternate",
      "color": "#ccfff7",
      "color2": "#6e6e6e",
      "period_s": 0.4
    },
    "SUCCESS": {
      "style": "solid",
      "color": "#00ff00",
      "color2": "#000000",
      "period_s": 1
    },
    "ERROR": {
      "style": "flash",
      "color": "#ff0000",
      "color2": "#000000",
      "period_s": 0.483333333333333
    },
    "ALERT": {
      "style": "alternate",
      "color": "#ff0000",
      "color2": "#fff700",
      "period_s": 0.4
    },
    "TIMING": {
      "style": "flash",
      "color": "#0062ff",
      "color2": "#000000",
      "period_s": 0.603333333333333
    },
    "COUNTING": {
      "style": "fade",
      "color": "#00eeff",
      "color2": "#0033ff",
      "period_s": 8
    },
    "WORKING": {
      "style": "breathe",
      "color": "#4400ff",
      "color2": "#000000",
      "period_s": 10
    },
    "RESTING": {
      "style": "breathe",
      "color": "#00ff88",
      "color2": "#000000",
      "period_s": 10
    },
    "METRONOME": {
      "style": "flash",
      "color": "#ffffff",
      "color2": "#000000",
      "period_s": 0.5
    }
  },
  "looks": {
    "Ponder": {
      "style": "fade",
      "color": "#454545",
      "color2": "#55aa9c",
      "period_s": 1
    },
    "Cops": {
      "style": "alternate",
      "color": "#fd3f3f",
      "color2": "#2e62ff",
      "period_s": 0.4
    }
  }
}
