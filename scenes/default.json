{
  "name": "Default",
  "ble_device_name": "AIButton",
  "sounds_enabled": false,
  "database_path": "data/events.db",
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8080,
  "min_flash_period_s": 0.3,
  "modes": [
    {
      "name": "Stopwatch",
      "template": "stopwatch",
      "activation": {
        "type": "manual"
      },
      "log_as": "stopwatch",
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 2,
            "color": "#421e00"
          },
          {
            "every_s": 1,
            "color": "#92904f"
          }
        ]
      }
    },
    {
      "name": "Pomodoro",
      "template": "pomodoro",
      "activation": {
        "type": "manual"
      },
      "looks": {
        "WORKING": "Ponder",
        "RESTING": "Cooldown"
      },
      "work_s": 1500,
      "break_s": 6006,
      "long_break_s": 900,
      "blocks_before_long_break": 4,
      "extend_s": 600,
      "rounds": 0,
      "lead_in_s": 3,
      "advance": "break_only",
      "log_as": "pomodoro",
      "waiting_style": "solid",
      "short_press": "toggle",
      "long_press": "exit",
      "double_tap": "extend"
    },
    {
      "name": "Metronome",
      "template": "metronome",
      "activation": {
        "type": "manual"
      },
      "ladder": {
        "enabled": true,
        "tick_s": 0.5,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 8,
            "color": "#00ff2a"
          },
          {
            "every_s": 4,
            "color": "#103d00"
          },
          {
            "every_s": 2,
            "color": "#4c8e9a"
          },
          {
            "every_s": 1,
            "color": "#1d2062"
          }
        ]
      },
      "start_bpm": 120,
      "tap_history": 4,
      "reset_gap_s": 2,
      "max_bpm": 600,
      "sound_on_tap": true,
      "log_as": "metronome",
      "clock_port": ""
    },
    {
      "name": "Counter",
      "template": "counter",
      "activation": {
        "type": "manual"
      },
      "event": "Habit",
      "looks": {
        "COUNTING": "Got It"
      }
    },
    {
      "name": "Alarm",
      "template": "alarm",
      "activation": {
        "type": "schedule",
        "at": "07:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "message": "Wake up",
      "label": "",
      "snooze_minutes": 10,
      "dismiss_event": "woke_up"
    },
    {
      "name": "Countdown 60s",
      "template": "countdown",
      "activation": {
        "type": "manual"
      },
      "minutes": 1,
      "label": "1min",
      "style": "flash",
      "period_s": 0.5,
      "ramp": [
        {
          "color": "#240000",
          "at": 0
        },
        {
          "color": "#703c00",
          "at": 0.2
        },
        {
          "color": "#999900",
          "at": 0.4
        },
        {
          "color": "#00c79f",
          "at": 0.6
        },
        {
          "color": "#000cb8",
          "at": 0.8
        },
        {
          "color": "#ffffff",
          "at": 1
        }
      ],
      "ring_on_finish": true,
      "log_as": "countdown",
      "ladder": {
        "enabled": true,
        "tick_s": 1,
        "base": "#000000",
        "rungs": [
          {
            "every_s": 10,
            "color": "#ffffff"
          },
          {
            "every_s": 5,
            "color": "#00ffd5"
          },
          {
            "every_s": 2,
            "color": "#6689db"
          }
        ]
      }
    },
    {
      "name": "Test Reminder",
      "template": "reminders",
      "activation": {
        "type": "schedule",
        "at": "12:45",
